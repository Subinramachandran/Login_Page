import { useState } from 'react'

const Dashboard = () => {
  const [inputValue, setInputValue] = useState("")
  const [items, setItems] = useState([])

  const addItem = () => {
    if (inputValue.trim() === "") return

    const newItem = {
      id: Date.now(),
      name: inputValue
    }
    setItems(prevItems => [...prevItems, newItem])
    setInputValue("")
  }

  return (
    <div className="min-h-screen bg-gray-100 flex justify-center items-start pt-20">
      <div className="w-full max-w-md bg-white rounded-xl shadow-lg p-6">
        <h1 className="text-3xl font-bold text-center text-blue-600 mb-6">
          Todo List
        </h1>

        <div className="flex gap-3">
          <input
            type="text"
            value={inputValue}
            onChange={(e) => setInputValue(e.target.value)}
            placeholder="Enter a task..."
            className="flex-1 border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />

          <button
            onClick={addItem}
            className="bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700 transition cursor-pointer"
          >
            Add
          </button>
        </div>

        <ul className="mt-6 space-y-3">
          {items.map((item) => (
            <li
              key={item.id}
              className="bg-gray-50 border rounded-lg px-4 py-3 shadow-sm"
            >
              {item.name}
            </li>
          ))}
        </ul>
      </div>
    </div>
  );
};

export default Dashboard